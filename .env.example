# Copy this file to .env.local and fill in your Supabase project values.
# Find these under Project Settings -> API in your Supabase dashboard.
# Never commit .env.local or your service_role key anywhere.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Razorpay publishable Key ID (safe for the browser — NOT the key secret).
# From Razorpay Dashboard -> Account & Settings -> API keys.
VITE_RAZORPAY_KEY_ID=

# AI features (routine generator, budget meal planner, dashboard insights) are
# powered by Google Gemini's free API tier. The key is NOT a Vite var and does
# NOT go here — it must never reach the browser. Instead, get a free key at
# aistudio.google.com/app/apikey and set it as a Supabase secret named
# GEMINI_API_KEY (Supabase Dashboard -> Edge Functions -> Secrets), where the
# ai-generate edge function reads it server-side.
