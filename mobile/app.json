{
  "expo": {
    "name": "FitTrack AI",
    "slug": "fittrack-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fittrackai",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080B09",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fittrackai.app"
    },
    "android": {
      "package": "com.fittrackai.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#080B09",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-video",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "FitTrack AI uses the camera to scan food barcodes and log progress photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C6FF00"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FitTrack AI uses your photo library to attach private progress photos."
        }
      ]
    ]
  }
}
